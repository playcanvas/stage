{
  "name": "@playcanvas/inspector",
  "version": "0.3.0",
  "description": "A debug panel for PlayCanvas apps: the entity hierarchy, assets, frame graph, render targets, textures, meshes, materials, scripts, cameras, memory, shaders and physics of a running app",
  "author": "PlayCanvas <support@playcanvas.com>",
  "homepage": "https://github.com/playcanvas/inspector#readme",
  "bugs": {
    "url": "https://github.com/playcanvas/inspector/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playcanvas/inspector.git"
  },
  "license": "MIT",
  "keywords": [
    "playcanvas",
    "inspector",
    "debug",
    "devtools",
    "webgl",
    "webgpu"
  ],
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "publint": "publint",
    "test": "mocha --recursive test --timeout 5000",
    "build:types": "tsc",
    "test:types": "tsc -p test/types"
  },
  "peerDependencies": {
    "playcanvas": "^2.23.0"
  },
  "devDependencies": {
    "@playcanvas/eslint-config": "3.0.0-beta.8",
    "chai": "6.2.2",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "mocha": "12.0.2",
    "playcanvas": "2.23.0",
    "publint": "0.3.24",
    "typescript": "5.9.3"
  }
}
